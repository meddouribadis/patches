From f7660aa2972f46f14803ad4245ee5944875937d9 Mon Sep 17 00:00:00 2001
From: Badis Meddouri <meddouri.badis@gmail.com>
Date: Thu, 1 Oct 2026 03:29:13 +0200
Subject: [PATCH] lineage_atv: route TVLauncher to system_ext when no product
 image is built

Change-Id: I68ec242fb2dbc25bf668ad51ad6032a0e9f9ee31
---
 apps/Android.mk | 8 ++++++++
 lineage_atv.mk  | 5 +++++
 2 files changed, 13 insertions(+)

diff --git a/apps/Android.mk b/apps/Android.mk
index 597348e..7e2a5da 100644
--- a/apps/Android.mk
+++ b/apps/Android.mk
@@ -22,7 +22,11 @@ LOCAL_CERTIFICATE := platform
 LOCAL_MODULE_CLASS := APPS
 LOCAL_PRIVILEGED_MODULE := true
 LOCAL_MODULE_SUFFIX := $(COMMON_ANDROID_PACKAGE_SUFFIX)
+ifeq ($(PRODUCT_BUILD_PRODUCT_IMAGE),false)
+LOCAL_SYSTEM_EXT_MODULE := true
+else
 LOCAL_PRODUCT_MODULE := true
+endif
 include $(BUILD_PREBUILT)
 
 include $(CLEAR_VARS)
@@ -33,7 +37,11 @@ LOCAL_CERTIFICATE := platform
 LOCAL_MODULE_CLASS := APPS
 LOCAL_PRIVILEGED_MODULE := true
 LOCAL_MODULE_SUFFIX := $(COMMON_ANDROID_PACKAGE_SUFFIX)
+ifeq ($(PRODUCT_BUILD_PRODUCT_IMAGE),false)
+LOCAL_SYSTEM_EXT_MODULE := true
+else
 LOCAL_PRODUCT_MODULE := true
+endif
 include $(BUILD_PREBUILT)
 
 include $(call all-makefiles-under,$(LOCAL_PATH))
diff --git a/lineage_atv.mk b/lineage_atv.mk
index 809c86b..6b5aa22 100644
--- a/lineage_atv.mk
+++ b/lineage_atv.mk
@@ -83,8 +83,13 @@ PRODUCT_PACKAGES += \
     TVRecommendationsNoGMS
 
 # priv-app permissions
+ifeq ($(PRODUCT_BUILD_PRODUCT_IMAGE),false)
+PRODUCT_COPY_FILES +=\
+    device/lineage/atv/permissions/privapp-permissions-lineage-atv.xml:$(TARGET_COPY_OUT_SYSTEM_EXT)/etc/permissions/privapp-permissions-lineage-atv.xml
+else
 PRODUCT_COPY_FILES +=\
     device/lineage/atv/permissions/privapp-permissions-lineage-atv.xml:$(TARGET_COPY_OUT_PRODUCT)/etc/permissions/privapp-permissions-lineage-atv.xml
+endif
 
 # Soong namespaces
 PRODUCT_SOONG_NAMESPACES += \
-- 
2.55.0

